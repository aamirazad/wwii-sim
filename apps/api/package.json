{
	"name": "api",
	"version": "0.2.0",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
		"start": "node dist/server.js",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:clone": "rsync aamir@raspberrypi:/home/aamir/apps/wwii-api/data/db-prod.sqlite db-prod.sqlite",
		"db:sync": "rsync db-prod.sqlite aamir@raspberrypi:/home/aamir/apps/wwii-api/data",
		"lint": "biome check",
		"check-types": "tsc --noEmit"
	},
	"dependencies": {
		"@elysiajs/cors": "^1.4.1",
		"@elysiajs/eden": "catalog:",
		"@elysiajs/node": "^1.4.5",
		"@elysiajs/openapi": "^1.4.14",
		"@paralleldrive/cuid2": "^3.3.0",
		"better-sqlite3": "^13.0.3",
		"dotenv": "^17.2.3",
		"drizzle-orm": "^0.45.1",
		"drizzle-typebox": "^0.3.3",
		"elysia": "^1.4.22",
		"nodemailer": "^9.0.5",
		"typescript": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "catalog:",
		"@types/nodemailer": "^8.0.1",
		"drizzle-kit": "^0.31.8",
		"esbuild": "^0.28.2",
		"tsx": "^4.23.12"
	},
	"main": "dist/server.js"
}
